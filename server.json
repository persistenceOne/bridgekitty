{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.persistenceOne/bridgekitty",
  "description": "Cross-chain bridge aggregator — compares LI.FI, deBridge, Relay, Across & more for best rates.",
  "repository": {
    "url": "https://github.com/persistenceOne/bridgekitty",
    "source": "github"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@persistenceone/bridgekitty",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "LI.FI API key for enhanced rate limits (optional, works without)",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "LIFI_API_KEY"
        },
        {
          "description": "Squid integrator ID (optional)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SQUID_INTEGRATOR_ID"
        }
      ]
    }
  ]
}
